<Window x:Class="Elektrikulu.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Elektrikulu.WpfApp"
        mc:Ignorable="d"
        Title="Elektrikulu" Height="450" Width="800">
    <Grid Background="#FFF4F7F2" Margin="1,0,-1,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="33*"/>
            <ColumnDefinition Width="767*"/>
        </Grid.ColumnDefinitions>

        <Label Content="Elektrikulu"
               HorizontalAlignment="Left"
               Margin="10,40,0,290"
               FontSize="36"
               FontWeight="Bold"
               Foreground="#FF033E06"
               Grid.Column="1" Width="191"/>

        <Rectangle HorizontalAlignment="Left"
                   Height="86"
                   Margin="12,149,0,0"
                   Stroke="#FFF1F1F1"
                   VerticalAlignment="Top"
                   Width="220"
                   RadiusX="8.136"
                   RadiusY="8.136"
                   Fill="White"
                   Grid.Column="1"/>

        <TextBox x:Name="tarbimine"
                   Text="0"
                   TextChanged="Input_Changed"
                   HorizontalAlignment="Left"
                   Margin="40,190,0,0"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   FontSize="20"
                   FontWeight="Bold"
                   Grid.Column="1" Width="117" Height="27" BorderBrush="#FFF0F2F9">

        </TextBox>
        <TextBlock x:Name="tarbimineError" Foreground="Red" FontSize="11" Visibility="Collapsed"/>

        <Label HorizontalAlignment="Left"
               Margin="30,151,0,0"
               Content="Elektritarbimine (kWh)"
               VerticalAlignment="Top"
               FontSize="18"
               Grid.Column="1" Height="34" Width="202"/>

        <Rectangle HorizontalAlignment="Left"
                   Height="86"
                   Margin="246,149,0,0"
                   Stroke="#FFF1F1F1"
                   VerticalAlignment="Top"
                   Width="262"
                   RadiusX="8.136"
                   RadiusY="8.136"
                   Fill="White"
                   Grid.Column="1"/>

        <TextBox x:Name="borsihind"
                   Text="0,0"
                   TextChanged="Input_Changed"
                   HorizontalAlignment="Left"
                   Margin="271,190,0,0"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   FontSize="20"
                   FontWeight="Bold"
                   Grid.Column="1" Height="27" Width="143" BorderBrush="#FFE1E3EA"></TextBox>
        <TextBlock x:Name="borsihindError" Foreground="Red" FontSize="11" Visibility="Collapsed"/>

        <Label HorizontalAlignment="Left"
               Margin="265,150,0,0"
               Content="Hetke börsihind (senti/kWh)"
               VerticalAlignment="Top"
               FontSize="18"
               Grid.Column="1" Height="34" Width="282"/>

        <Rectangle HorizontalAlignment="Left"
                   Height="86"
                   Margin="525,149,0,0"
                   Stroke="#FFF1F1F1"
                   VerticalAlignment="Top"
                   Width="175"
                   RadiusX="8.136"
                   RadiusY="8.136"
                   Fill="White"
                   Grid.Column="1"/>

        <TextBox x:Name="kaibemaks"
                   Text="24"
                   TextChanged="Input_Changed"
                   HorizontalAlignment="Left"
                   Margin="551,190,0,0"
                   VerticalAlignment="Top"
                   FontSize="20"
                   FontWeight="Bold"
                   Grid.Column="1" Height="27" Width="84" BorderBrush="#FFEBEEF7">
        </TextBox>
        <TextBlock x:Name="kaibemaksError" Foreground="Red" FontSize="11" Visibility="Collapsed"/>

        <Label HorizontalAlignment="Left"
               Margin="544,151,0,0"
               Content="Käibemaks (%)"
               VerticalAlignment="Top"
               FontSize="18"
               Grid.Column="1" Height="34" Width="126"/>

        <Label Content="Arve kokku"
               HorizontalAlignment="Left"
               Margin="583,257,0,111"
               FontSize="20"
               FontWeight="Bold"
               Foreground="#FF033E06"
               Grid.Column="1" Width="117"/>

        <Label x:Name="arve_kokku" Content="0.00 €"
               HorizontalAlignment="Left"
               Margin="271,284,0,49"
               FontSize="48"
               FontWeight="Bold"
               Foreground="#FF033E06"
               Width="429"
               HorizontalContentAlignment="Right"
               Grid.Column="1"/>

        <Label HorizontalAlignment="Left"
               Margin="12,96,0,0"
               Content="kulu eurodes 30 päeva jooksul"
               VerticalAlignment="Top"
               FontSize="14"
               HorizontalContentAlignment="Right"
               Grid.Column="1" Height="29" Width="197"/>
        <CheckBox x:Name="kaibemaks_check" Grid.Column="1" Content="" HorizontalAlignment="Left" Margin="670,162,0,0" VerticalAlignment="Top" Checked="Input_Changed" Unchecked="Input_Changed" Width="15" Height="15"/>
    </Grid>
</Window>